datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATRON
  LIBRARIAN
}

enum BorrowStatus {
  REQUESTED
  APPROVED
  REJECTED
  BORROWED
  RETURNED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  passwordHash   String
  role           Role            @default(PATRON)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reviews        Review[]
  borrowRequests BorrowRequest[]
  bookings       Booking[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id             Int             @id @default(autoincrement())
  title          String
  author         String
  isbn           String          @unique
  publishedYear  Int?
  totalCopies    Int             @default(1)
  genreId        Int
  genre          Genre           @relation(fields: [genreId], references: [id], onDelete: Cascade)
  reviews        Review[]
  borrowRequests BorrowRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1 to 5 stars
  comment   String?
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BorrowRequest {
  id          Int          @id @default(autoincrement())
  status      BorrowStatus @default(REQUESTED)
  requestedAt DateTime     @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  fineAmount  Decimal      @default(0) @db.Decimal(10, 2)
  bookId      Int
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([bookId, status])
}

model Space {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  capacity  Int       @default(1)
  isActive  Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id        Int           @id @default(autoincrement())
  status    BookingStatus @default(REQUESTED)
  startAt   DateTime
  endAt     DateTime
  spaceId   Int
  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([spaceId, startAt, endAt])
  @@index([userId, status])
}
